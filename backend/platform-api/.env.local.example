# Local Core lab — copy to .env.local and adjust only if needed.
# No prod hosts, secrets, or live service tokens.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Staging Postgres from postgres/docker-compose.local-staging.yml (host port 55432)
PLATFORM_DATABASE_URL=postgresql://whieda_platform_api_local:local_core_api_only@host.docker.internal:55432/whieda_platform_local_core

# Block outbound legacy integrations in local lab (nothing listens here)
PLATFORM_LEGACY_N8N_BASE_URL=http://127.0.0.1:9/__local_lab_n8n_blocked__
PLATFORM_LEAD_DELIVERY_WEBHOOK_PATH=/__local_lab_lead_delivery_blocked__

# Local lab routes — no live Telegram/n8n forwarding
CORE_ROUTE_PUBLIC_REF=core
CORE_ROUTE_LEADS=core
CORE_ROUTE_ADVISOR=core
CORE_ROUTE_TELEGRAM=core
CORE_ROUTE_DEEP=off

# Dev-only public host fallback (tenant resolution via Host header)
PLATFORM_DEFAULT_HOST_TENANT=
