# Local Core lab — copy to .env.local and adjust only if needed.
# No prod hosts, secrets, or live service tokens.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Staging Postgres from postgres/docker-compose.local-staging.yml (host port 55432)
PLATFORM_DATABASE_URL=postgresql://whieda_platform_api_local:local_core_api_only@host.docker.internal:55432/whieda_platform_local_core

# Block outbound legacy integrations in local lab (nothing listens here)
PLATFORM_LEGACY_N8N_BASE_URL=http://127.0.0.1:9/__local_lab_n8n_blocked__
PLATFORM_LEAD_DELIVERY_WEBHOOK_PATH=/__local_lab_lead_delivery_blocked__

# Local lab routes — no live Telegram/n8n forwarding
CORE_ROUTE_PUBLIC_REF=core
CORE_ROUTE_LEADS=core
CORE_ROUTE_ADVISOR=core
CORE_ROUTE_TELEGRAM=core
CORE_ROUTE_DEEP=off

# Dev-only public host fallback (tenant resolution via Host header)
PLATFORM_DEFAULT_HOST_TENANT=

# Theme access: grant theme customization to any verified Telegram user on
# enabled personal profiles (owner-only entitlement when false)
THEME_TEMPORARY_FREE_FOR_VERIFIED_TELEGRAM_USERS=false

# Paid partner library. Production must use s3, never local.
PLATFORM_PARTNER_LIBRARY_STORAGE_BACKEND=local
PLATFORM_PARTNER_LIBRARY_LOCAL_ROOT=./var/partner-library
PLATFORM_PARTNER_LIBRARY_LOCAL_SIGNING_SECRET=replace-for-local-shared-dev
PLATFORM_PARTNER_LIBRARY_LOCAL_BASE_URL=/api/v1/partner-library/local-files
PLATFORM_PARTNER_LIBRARY_SIGNED_URL_TTL_SECONDS=300
# Staging/production MVP may use a private read-only filesystem mount instead.
# PLATFORM_PARTNER_LIBRARY_STORAGE_BACKEND=filesystem
# PLATFORM_PARTNER_LIBRARY_FILESYSTEM_ROOT=/var/lib/wwc-partner-library
# PLATFORM_PARTNER_LIBRARY_FILESYSTEM_SIGNING_SECRET=<random-32+-chars>
# PLATFORM_PARTNER_LIBRARY_FILESYSTEM_BASE_URL=/api/v1/partner-library/files
# S3 credentials use standard AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY env secrets.
# PLATFORM_PARTNER_LIBRARY_S3_BUCKET=wwc-private-library
# PLATFORM_PARTNER_LIBRARY_S3_ENDPOINT_URL=https://s3.example.com
# PLATFORM_PARTNER_LIBRARY_S3_REGION=eu-central-1
# PLATFORM_PARTNER_LIBRARY_S3_ADDRESSING_STYLE=auto

# Private edge snapshot and fallback owner for unattributed leads.
PLATFORM_EDGE_SNAPSHOT_SECRET=replace-for-local-edge-sync
PLATFORM_ORGANIC_OWNER_ID=viktor
