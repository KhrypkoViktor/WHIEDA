# Copy to .env on the application server. Do not commit secrets.

PLATFORM_DATABASE_URL=postgresql://user:password@host:5432/postgres
PLATFORM_REDIS_URL=redis://redis:6379/0
PLATFORM_LEGACY_N8N_BASE_URL=https://sysarchn8n.duckdns.org
PLATFORM_LEAD_DELIVERY_WEBHOOK_PATH=/webhook/whieda-lead-delivery-v1
# Fetched at deploy from n8n WHIEDA_ADVISOR_TELEGRAM_BOT_TOKEN (not committed)
PLATFORM_TELEGRAM_BOT_TOKEN=
PLATFORM_TELEGRAM_WEBHOOK_SECRET=

CORE_ROUTE_PUBLIC_REF=core
CORE_ROUTE_LEADS=core
CORE_ROUTE_ADVISOR=legacy
CORE_ROUTE_TELEGRAM=legacy
CORE_ROUTE_DEEP=off
