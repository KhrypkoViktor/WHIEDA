# Copy to .env on the application server. Do not commit secrets.

PLATFORM_DATABASE_URL=postgresql://user:password@host:5432/postgres
PLATFORM_REDIS_URL=redis://redis:6379/0
PLATFORM_LEGACY_N8N_BASE_URL=https://sysarchn8n.duckdns.org
PLATFORM_LEAD_DELIVERY_WEBHOOK_PATH=/webhook/whieda-lead-delivery-v1
# Fetched at deploy from n8n WHIEDA_ADVISOR_TELEGRAM_BOT_TOKEN (not committed)
PLATFORM_TELEGRAM_BOT_TOKEN=
# full: staging/test bot with every feature. minimal: production bot while
# site setup, payments and renewals are confirmed manually by the administrator.
PLATFORM_TELEGRAM_UI_PROFILE=full
PLATFORM_TELEGRAM_WEBHOOK_SECRET=
# Set only in the deployment secret store. Do not reuse the admin ID list.
# PLATFORM_BILLING_OWNER_TELEGRAM_ID=123456789
# Shared only with the site-host edge sync service. Generate a long random value.
PLATFORM_EDGE_SNAPSHOT_SECRET=
# One actor ID receives new leads when a referral is unavailable or unpaid.
PLATFORM_ORGANIC_OWNER_ID=viktor

CORE_ROUTE_PUBLIC_REF=core
CORE_ROUTE_LEADS=core
CORE_ROUTE_ADVISOR=legacy
CORE_ROUTE_TELEGRAM=legacy
CORE_ROUTE_DEEP=off
