# Private filesystem MVP. Real secret stays only in the server .env (mode 0600).
PLATFORM_PARTNER_LIBRARY_STORAGE_BACKEND=filesystem
PLATFORM_PARTNER_LIBRARY_HOST_ROOT=/var/lib/wwc-partner-library
PLATFORM_PARTNER_LIBRARY_FILESYSTEM_ROOT=/var/lib/wwc-partner-library
PLATFORM_PARTNER_LIBRARY_FILESYSTEM_SIGNING_SECRET=<random-at-least-32-characters>
PLATFORM_PARTNER_LIBRARY_FILESYSTEM_BASE_URL=/api/v1/partner-library/files
PLATFORM_PARTNER_LIBRARY_SIGNED_URL_TTL_SECONDS=300
