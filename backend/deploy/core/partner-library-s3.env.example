# WWC private partner library on Contabo Object Storage EU.
# Keep real values only in the server .env (mode 0600); never commit them.
PLATFORM_PARTNER_LIBRARY_STORAGE_BACKEND=s3
PLATFORM_PARTNER_LIBRARY_S3_BUCKET=wwc-best-private-library
PLATFORM_PARTNER_LIBRARY_S3_ENDPOINT_URL=https://eu2.contabostorage.com
PLATFORM_PARTNER_LIBRARY_S3_REGION=default
PLATFORM_PARTNER_LIBRARY_S3_ADDRESSING_STYLE=path
PLATFORM_PARTNER_LIBRARY_SIGNED_URL_TTL_SECONDS=300
AWS_ACCESS_KEY_ID=<contabo-s3-access-key>
AWS_SECRET_ACCESS_KEY=<contabo-s3-secret-key>
